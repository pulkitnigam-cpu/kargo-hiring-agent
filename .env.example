# Neon Postgres (Vercel → Storage → Neon adds both automatically)
# pooled connection, used by the app
DATABASE_URL=
# direct connection, used for schema changes
DATABASE_URL_UNPOOLED=

# AI scoring (Google Gemini API key from aistudio.google.com)
GEMINI_API_KEY=
# Optional: model (default gemini-3.1-pro-preview) and CVs scored at once (default 2)
GEMINI_MODEL=
GEMINI_CONCURRENCY=

# Email (Resend). Use a "Full access" key if you want delivered/bounced status;
# a "Sending access" key sends fine but can't read status.
RESEND_API_KEY=
# Test mode (default on): every email goes to TEST_RECIPIENT, never a candidate.
TEST_MODE=true
TEST_RECIPIENT=
# Real sending: Arjun's own address on a domain verified in Resend (never noreply).
FROM_EMAIL=onboarding@resend.dev
REPLY_TO_EMAIL=
# Booking link used in invites
CAL_LINK=
# Optional: undo window in minutes (default 10)
UNDO_MINUTES=

# Daily cron (Vercel sends it as a Bearer token)
CRON_SECRET=

# Dashboard login. Required when hosted; locally, empty means no login.
DASHBOARD_PASSWORD=
# Optional: separate secret for signing sessions (defaults to the password)
AUTH_SECRET=

# Optional: shows "open N days" per role on the dashboard
ROLES_OPENED_AT=
